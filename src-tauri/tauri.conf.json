{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VenCoder",
  "version": "2.0.0",
  "identifier": "com.vencoder.app",
  "build": {
    "beforeDevCommand": "npm run dev --prefix electron",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build --prefix electron",
    "frontendDist": "../electron/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "VenCoder",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "devtools": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "longDescription": "AI coding assistant with Memory, Skills, Hooks, Plugins, Checkpoints, Git Workflow, Type Checking, Linting, Security Scanning, Code Review, Session Management, and Collaboration features",
    "shortDescription": "VenCoder AI Coding Assistant",
    "resources": ["../backend", "../python-runtime"],
    "category": "DeveloperTool",
    "copyright": "Copyright 2024",
    "license": "MIT"
  }
}
